# Klaviyo — public (safe to expose in browser bundles)
# Get from: Klaviyo → Settings → Account → API Keys → Public API Key
PUBLIC_KLAVIYO_KEY=pk_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# The Klaviyo list ID for waitlist signups.
# Get from: Klaviyo → Lists → your list → URL (…/lists/XXXXXX/...)
PUBLIC_KLAVIYO_LIST_ID=XXXXXX

# Advertiser portal (ads.joinnile.com). Anon key is public-safe (RLS protects data).
# From: Supabase → Project Settings → API. NEVER put the service-role key here.
PUBLIC_SUPABASE_URL=https://jelmkkvyrliywcdkzhuu.supabase.co
PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
PUBLIC_CREATE_AD_PAYMENT_URL=https://jelmkkvyrliywcdkzhuu.functions.supabase.co/create-ad-payment
PUBLIC_REVIEW_AD_CAMPAIGN_URL=https://jelmkkvyrliywcdkzhuu.functions.supabase.co/review-ad-campaign
PUBLIC_MODERATE_REPORT_URL=https://jelmkkvyrliywcdkzhuu.functions.supabase.co/moderate-report

# --- Ad + analytics tracking (all optional — a blank var just skips that tag) ---

# GA4 measurement ID. Get from: Google Analytics → Admin → Data Streams → your
# web stream → "Measurement ID" (starts with G-).
PUBLIC_GA4_ID=G-XXXXXXXXXX

# Google Ads conversion tracking. Get from: Google Ads → Goals → Conversions →
# + New conversion action → pick "Website" → after creating it, the "Tag
# setup" step shows both values: the ID (starts with AW-) and the label
# (a long alphanumeric string) for the specific conversion action.
PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
PUBLIC_GOOGLE_ADS_LABEL=XXXXXXXXXXXXXXXXXXXX

# Meta (Facebook/Instagram) Pixel. Get from: Meta Events Manager
# (business.facebook.com/events_manager) → Data Sources → your Pixel →
# Settings → "Pixel ID".
PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX
