---
import "../styles/brand.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WaitlistModal from "../components/WaitlistModal.vue";
import { SITE } from "../site.config";

interface Props {
  title?: string;
  description?: string;
  /** Path-only canonical, e.g. "/host". Defaults to current URL. */
  canonical?: string;
  ogImage?: string;
  /** Raw JSON-LD string injected into <head> (e.g. FAQPage schema). */
  jsonLd?: string;
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  canonical,
  ogImage = SITE.ogImage,
  jsonLd,
} = Astro.props;

const canonicalUrl = new URL(canonical ?? Astro.url.pathname, SITE.domain).href;
const ogImageUrl = new URL(ogImage, SITE.domain).href;

// Ad + analytics tracking (GA4 + Google Ads conversion + Meta Pixel). All
// optional — unset env vars just mean that tag never loads. Set via
// PUBLIC_GA4_ID / PUBLIC_GOOGLE_ADS_ID / PUBLIC_GOOGLE_ADS_LABEL /
// PUBLIC_META_PIXEL_ID (see .env.example).
const GA4_ID = import.meta.env.PUBLIC_GA4_ID || "";
const ADS_ID = import.meta.env.PUBLIC_GOOGLE_ADS_ID || "";
const ADS_LABEL = import.meta.env.PUBLIC_GOOGLE_ADS_LABEL || "";
const META_PIXEL_ID = import.meta.env.PUBLIC_META_PIXEL_ID || "";
const hasTracking = Boolean(GA4_ID || ADS_ID || META_PIXEL_ID);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
    <link rel="icon" href="/favicon.png?v=2" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts: Syne (display) + Outfit (body) + Material Symbols (icons) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600&family=Syne:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <!-- Icons load separately with display=block: with swap, a slow or failed
         load shows the ligature names ("play_circle") as words. icon_names
         subsets the font to the glyphs we use (alphabetical; add new ones). -->
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,1,0&icon_names=dynamic_feed,group,handshake,play_circle,rocket_launch,school&display=block"
      rel="stylesheet"
    />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <slot name="head" />

    {
      hasTracking && (
        <script
          is:inline
          define:vars={{ GA4_ID, ADS_ID, ADS_LABEL, META_PIXEL_ID }}
        >
          // Ad/analytics loader, gated on consent. Respects both the site's
          // own "Your Privacy Choices" footer toggle and the browser's
          // Global Privacy Control signal — either one skips every tag
          // below entirely. See /cookies for what each tag is for.
          (function () {
            var optedOut = false;
            try {
              optedOut =
                localStorage.getItem("nile-ad-optout") === "1" ||
                navigator.globalPrivacyControl === true;
            } catch (e) {}

            // No-op defaults so callers never have to null-check. Replaced
            // with the real implementations below once the tags load.
            window.nileTrack = {
              signup: function () {},
              event: function () {},
            };

            if (optedOut) return;

            // The page a visitor first landed on is the one the ad paid for.
            // Later events fire on whatever page they navigated to, so keep
            // the entry path for the session and report both.
            var landingPage = location.pathname;
            try {
              var stored = sessionStorage.getItem("nile-landing-page");
              if (stored) landingPage = stored;
              else sessionStorage.setItem("nile-landing-page", landingPage);
            } catch (e) {}

            if (GA4_ID || ADS_ID) {
              var tagId = GA4_ID || ADS_ID;
              var s = document.createElement("script");
              s.async = true;
              s.src = "https://www.googletagmanager.com/gtag/js?id=" + tagId;
              document.head.appendChild(s);
              window.dataLayer = window.dataLayer || [];
              window.gtag = function () {
                window.dataLayer.push(arguments);
              };
              window.gtag("js", new Date());
              if (GA4_ID) window.gtag("config", GA4_ID, { anonymize_ip: true });
              if (ADS_ID)
                window.gtag("config", ADS_ID, {
                  allow_enhanced_conversions: true,
                });
            }

            if (META_PIXEL_ID) {
              (function (f, b, e, v, n, t, s) {
                if (f.fbq) return;
                n = f.fbq = function () {
                  n.callMethod
                    ? n.callMethod.apply(n, arguments)
                    : n.queue.push(arguments);
                };
                if (!f._fbq) f._fbq = n;
                n.push = n;
                n.loaded = true;
                n.version = "2.0";
                n.queue = [];
                t = b.createElement(e);
                t.async = true;
                t.src = v;
                s = b.getElementsByTagName(e)[0];
                s.parentNode.insertBefore(t, s);
              })(
                window,
                document,
                "script",
                "https://connect.facebook.net/en_US/fbevents.js",
              );
              window.fbq("init", META_PIXEL_ID);
              window.fbq("track", "PageView");
            }

            window.nileTrack = {
              // Called by the waitlist modal on a successful signup.
              // `email` powers Google's enhanced conversions: gtag hashes it
              // with SHA-256 in the browser before anything is sent, so the
              // raw address never leaves the page. It lets Google match
              // signups back to ad clicks that cookie-based tracking misses,
              // which on a lead form is most of them. Described in /cookies.
              signup: function (segment, email) {
                var where = {
                  landing_page: landingPage,
                  source_page: location.pathname,
                  segment: segment || "unknown",
                };
                if (window.gtag && ADS_ID) {
                  if (email) {
                    window.gtag("set", "user_data", {
                      email: String(email).trim().toLowerCase(),
                    });
                  }
                  window.gtag("event", "conversion", {
                    send_to: ADS_ID + (ADS_LABEL ? "/" + ADS_LABEL : ""),
                  });
                }
                if (window.gtag && GA4_ID) {
                  window.gtag(
                    "event",
                    "sign_up",
                    Object.assign({ method: "waitlist" }, where),
                  );
                }
                if (window.fbq) {
                  window.fbq(
                    "track",
                    "Lead",
                    Object.assign({ content_name: "waitlist_signup" }, where),
                  );
                }
              },

              // Softer signals (CTA clicks, download intent). NOT conversions
              // — they exist so GA4 can build remarketing audiences and show
              // which marketing page actually drives interest, long before
              // signup volume is high enough to read on its own.
              event: function (name, params) {
                var payload = Object.assign(
                  {
                    landing_page: landingPage,
                    source_page: location.pathname,
                  },
                  params || {},
                );
                if (window.gtag && GA4_ID) window.gtag("event", name, payload);
                if (window.fbq) window.fbq("trackCustom", name, payload);
              },
            };
          })();
        </script>
      )
    }
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WaitlistModal client:idle />

    <script is:inline>
      // Any element with [data-waitlist] opens the modal. Optional
      // data-segment="host|viewer|advertiser" preselects the segment.
      document.addEventListener("click", (e) => {
        const t = e.target.closest("[data-waitlist]");
        if (!t) return;
        e.preventDefault();
        const segment = t.getAttribute("data-segment") || undefined;
        // Intent signal: which CTA on which page made someone open the form.
        // Pairs with sign_up to give a per-page open→submit rate.
        window.nileTrack?.event("waitlist_open", {
          segment: segment || "unknown",
        });
        window.dispatchEvent(
          new CustomEvent("nile:waitlist-open", { detail: { segment } }),
        );
      });

      // Any element with data-track="event_name" reports itself when clicked.
      // Generic on purpose: new CTAs opt in with an attribute, not new script.
      document.addEventListener("click", (e) => {
        const t = e.target.closest("[data-track]");
        if (!t) return;
        window.nileTrack?.event(t.getAttribute("data-track"), {
          label:
            t.getAttribute("data-track-label") ||
            (t.textContent || "").trim().slice(0, 60),
        });
      });
    </script>

    <script is:inline>
      // Self-heal for a page whose hashed asset files are gone. Each deploy
      // deletes the previous build's hashes, so any copy of this HTML that
      // outlives a deploy (a restored Safari tab, an in-app browser, a CDN
      // edge) asks for scripts that 404: the portal and waitlist islands never
      // mount. CSS can't break this way any more: it's inlined into every page
      // (astro.config.mjs, inlineStylesheets: "always").
      //
      // An island that hydrated has lost its `ssr` attribute. One that hasn't,
      // 5s after load, gets its module checked; a 404 means a stale page, so
      // fetch a fresh copy with a cache-busting param (a plain reload can be
      // answered from the same stale cache). At most once a minute per tab.
      (() => {
        const KEY = "nile-stale-recovery";
        const url = new URL(location.href);
        if (url.searchParams.has("_fresh")) {
          url.searchParams.delete("_fresh");
          history.replaceState(history.state, "", url);
        }
        addEventListener("load", () =>
          setTimeout(async () => {
            const stuck = [
              ...document.querySelectorAll("astro-island[ssr][component-url]"),
            ].filter((el) => el.getAttribute("client") !== "visible");
            if (!stuck.length) return;
            const gone = await Promise.all(
              stuck.map((el) =>
                fetch(el.getAttribute("component-url"), {
                  method: "HEAD",
                  cache: "no-store",
                })
                  .then((r) => r.status === 404)
                  .catch(() => false),
              ),
            );
            if (!gone.includes(true)) return;
            try {
              const last = Number(sessionStorage.getItem(KEY) || 0);
              if (Date.now() - last < 60000) return;
              sessionStorage.setItem(KEY, String(Date.now()));
            } catch {
              return;
            }
            url.searchParams.set("_fresh", Date.now().toString(36));
            location.replace(url);
          }, 5000),
        );
      })();
    </script>
  </body>
</html>
