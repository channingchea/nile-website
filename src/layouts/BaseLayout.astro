---
import "../styles/brand.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WaitlistModal from "../components/WaitlistModal.vue";
import { SITE } from "../site.config";

interface Props {
  title?: string;
  description?: string;
  /** Path-only canonical, e.g. "/host". Defaults to current URL. */
  canonical?: string;
  ogImage?: string;
  /** Raw JSON-LD string injected into <head> (e.g. FAQPage schema). */
  jsonLd?: string;
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  canonical,
  ogImage = SITE.ogImage,
  jsonLd,
} = Astro.props;

const canonicalUrl = new URL(canonical ?? Astro.url.pathname, SITE.domain).href;
const ogImageUrl = new URL(ogImage, SITE.domain).href;

// Ad + analytics tracking (GA4 + Google Ads conversion + Meta Pixel). All
// optional — unset env vars just mean that tag never loads. Set via
// PUBLIC_GA4_ID / PUBLIC_GOOGLE_ADS_ID / PUBLIC_GOOGLE_ADS_LABEL /
// PUBLIC_META_PIXEL_ID (see .env.example).
const GA4_ID = import.meta.env.PUBLIC_GA4_ID || "";
const ADS_ID = import.meta.env.PUBLIC_GOOGLE_ADS_ID || "";
const ADS_LABEL = import.meta.env.PUBLIC_GOOGLE_ADS_LABEL || "";
const META_PIXEL_ID = import.meta.env.PUBLIC_META_PIXEL_ID || "";
const hasTracking = Boolean(GA4_ID || ADS_ID || META_PIXEL_ID);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
    <link rel="icon" href="/favicon.png?v=2" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts: Syne (display) + Outfit (body) + Material Symbols (icons) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,1,0&family=Outfit:wght@300;400;500;600&family=Syne:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <slot name="head" />

    {
      hasTracking && (
        <script
          is:inline
          define:vars={{ GA4_ID, ADS_ID, ADS_LABEL, META_PIXEL_ID }}
        >
          // Ad/analytics loader, gated on consent. Respects both the site's
          // own "Your Privacy Choices" footer toggle and the browser's
          // Global Privacy Control signal — either one skips every tag
          // below entirely. See /cookies for what each tag is for.
          (function () {
            var optedOut = false;
            try {
              optedOut =
                localStorage.getItem("nile-ad-optout") === "1" ||
                navigator.globalPrivacyControl === true;
            } catch (e) {}

            window.nileTrack = { signup: function () {} }; // no-op default

            if (optedOut) return;

            if (GA4_ID || ADS_ID) {
              var tagId = GA4_ID || ADS_ID;
              var s = document.createElement("script");
              s.async = true;
              s.src = "https://www.googletagmanager.com/gtag/js?id=" + tagId;
              document.head.appendChild(s);
              window.dataLayer = window.dataLayer || [];
              window.gtag = function () {
                window.dataLayer.push(arguments);
              };
              window.gtag("js", new Date());
              if (GA4_ID) window.gtag("config", GA4_ID, { anonymize_ip: true });
              if (ADS_ID) window.gtag("config", ADS_ID);
            }

            if (META_PIXEL_ID) {
              (function (f, b, e, v, n, t, s) {
                if (f.fbq) return;
                n = f.fbq = function () {
                  n.callMethod
                    ? n.callMethod.apply(n, arguments)
                    : n.queue.push(arguments);
                };
                if (!f._fbq) f._fbq = n;
                n.push = n;
                n.loaded = true;
                n.version = "2.0";
                n.queue = [];
                t = b.createElement(e);
                t.async = true;
                t.src = v;
                s = b.getElementsByTagName(e)[0];
                s.parentNode.insertBefore(t, s);
              })(
                window,
                document,
                "script",
                "https://connect.facebook.net/en_US/fbevents.js",
              );
              window.fbq("init", META_PIXEL_ID);
              window.fbq("track", "PageView");
            }

            // Called by the waitlist form/modal on a successful signup.
            window.nileTrack = {
              signup: function (segment) {
                if (window.gtag && ADS_ID) {
                  window.gtag("event", "conversion", {
                    send_to: ADS_ID + (ADS_LABEL ? "/" + ADS_LABEL : ""),
                  });
                }
                if (window.gtag && GA4_ID) {
                  window.gtag("event", "sign_up", {
                    method: "waitlist",
                    segment: segment || "unknown",
                  });
                }
                if (window.fbq) {
                  window.fbq("track", "Lead", {
                    content_name: "waitlist_signup",
                    segment: segment || "unknown",
                  });
                }
              },
            };
          })();
        </script>
      )
    }
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WaitlistModal client:idle />

    <script is:inline>
      // Any element with [data-waitlist] opens the modal. Optional
      // data-segment="host|viewer|advertiser" preselects the segment.
      document.addEventListener("click", (e) => {
        const t = e.target.closest("[data-waitlist]");
        if (!t) return;
        e.preventDefault();
        window.dispatchEvent(
          new CustomEvent("nile:waitlist-open", {
            detail: { segment: t.getAttribute("data-segment") || undefined },
          }),
        );
      });
    </script>

    <script is:inline>
      // Self-heal for a browser still holding a pre-.htaccess cached copy of
      // this page: its hashed stylesheets were deleted by a later deploy, so
      // they 404 and the page renders unstyled. A failed same-origin sheet
      // still exposes a CSSStyleSheet — it just has no rules. Reload once
      // (a reload always revalidates); the guard stops any loop.
      addEventListener("load", () => {
        const stale = [
          ...document.querySelectorAll('link[rel="stylesheet"][href^="/_astro/"]'),
        ].some((l) => {
          try {
            return !l.sheet || l.sheet.cssRules.length === 0;
          } catch {
            return false;
          }
        });
        if (!stale) return;
        try {
          if (sessionStorage.getItem("nile-css-recovery")) return;
          sessionStorage.setItem("nile-css-recovery", "1");
        } catch {
          return;
        }
        location.reload();
      });
    </script>
  </body>
</html>
