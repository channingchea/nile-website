---
import BaseLayout from "../layouts/BaseLayout.astro";
import ImageSlot from "../components/ImageSlot.astro";

const title = "Premiere Your Film Online & Sell Tickets | For Filmmakers | Nile";
const description =
  "Host a ticketed online premiere of your film. Screen it live, run a multi-angle Q&A with your cast, sell replay access afterward, and keep your rights and your box office.";

// Used only by the Proof section, which is commented out below until we have
// real filmmaker testimonials and ticket-sales figures.
// eslint-disable-next-line @typescript-eslint/no-unused-vars
const proofPremieres = [
  {
    label: "short film premiere",
    meta: "3 angles · Sold out",
    src: "/img/filmmakers-angle-screen.jpg",
    alt: "Audience seated in a cinema watching a film on a large screen",
  },
  {
    label: "documentary night",
    meta: "Panel + director",
    src: "/img/filmmakers-angle-director.jpg",
    alt: "Director seated at a monitor wearing headphones on set",
  },
  {
    label: "festival encore",
    meta: "Replay included",
    src: "/img/filmmakers-angle-room.jpg",
    alt: "Small audience watching a screening in a dark theater",
  },
];
---

<BaseLayout title={title} description={description} canonical="/filmmakers">
  <!-- HERO -->
  <section class="hero nile-section">
    <div class="nile-container hero-grid">
      <div class="hero-copy">
        <p class="nile-eyebrow">For Filmmakers</p>
        <h1 class="hero-h1">Your premiere. Your box office.</h1>
        <p class="nile-lead">
          Nile turns your screening into a ticketed live event. Sell seats to an
          online premiere, play the film, and take questions from the audience
          the moment the credits roll.
        </p>
        <div class="hero-cta">
          <button
            type="button"
            data-waitlist
            data-segment="filmmaker"
            class="nile-btn nile-btn--primary"
          >
            Premiere Your Film →
          </button>
        </div>
      </div>
      <ImageSlot
        label="premiere night"
        src="/img/filmmakers-hero.jpg"
        alt="Full cinema audience watching a film premiere on a lit screen"
        radius="lg"
        ratio="4 / 3"
        class="hero-visual"
      />
    </div>
  </section>

  <!-- THE WAIT SECTION -->
  <section class="band nile-section">
    <div class="nile-container wait-grid">
      <ImageSlot
        label="festival marquee"
        src="/img/filmmakers-festival.jpg"
        alt="Crowd waiting outside a lit cinema marquee at a film festival at night"
        radius="lg"
        ratio="3 / 4"
        class="wait-visual"
      />
      <div class="wait-copy">
        <p class="nile-eyebrow">The wait</p>
        <h2>You finished the film. Now you're waiting for permission.</h2>
        <p class="seo-h2">How to premiere your film online and sell tickets</p>
        <p>
          Submission fees. Six-month waits. A rejection email, or an acceptance
          that fills someone else's room and takes a cut of the door.
        </p>
        <p>
          Nile is the other path. Set a date, set a ticket price, share the
          link. Your premiere happens when you say it does, in front of the
          people who already want to see it. You keep the rights, the audience,
          and the box office.
        </p>
      </div>
    </div>
  </section>

  <!-- PREMIERE NIGHT SECTION -->
  <section class="nile-section">
    <div class="nile-container setup-grid">
      <div class="setup-copy">
        <p class="nile-eyebrow">Premiere night</p>
        <h2>A screening, not a streaming link.</h2>
        <p class="seo-h2">Live streaming a film premiere with a Q&amp;A</p>
        <p>
          Anyone can send a private link. That's not a premiere. That's
          homework.
        </p>
        <p>
          On Nile your premiere is a live event with a start time and a room
          full of people in it. You introduce the film on camera. You share your
          screen and play it. Then the lights come up and you're live with your
          audience for the Q&amp;A.
        </p>
        <p>
          Nile runs multiple camera angles at once, so the talkback isn't one
          static shot. Director close-up. Panel wide. Cast joining on their own
          phones from wherever they are. Your audience picks the view.
        </p>
        <div class="pull-card nile-card">
          <p>
            Chat runs the whole time. The reaction you'd get in a theater, you
            get on the stream.
          </p>
        </div>
      </div>
      <div class="angle-row">
        <ImageSlot
          label="the film"
          src="/img/filmmakers-angle-screen.jpg"
          alt="Audience seated in a cinema watching a film on a large screen"
          radius="md"
          ratio="3 / 4"
        />
        <ImageSlot
          label="director cam"
          src="/img/filmmakers-angle-director.jpg"
          alt="Director seated at a monitor wearing headphones on set"
          radius="md"
          ratio="3 / 4"
        />
        <ImageSlot
          label="the room"
          src="/img/filmmakers-angle-room.jpg"
          alt="Small audience watching a screening in a dark theater"
          radius="md"
          ratio="3 / 4"
        />
      </div>
    </div>
  </section>

  <!-- VOD SECTION -->
  <section class="band nile-section">
    <div class="nile-container vod-grid">
      <ImageSlot
        label="replay player"
        src="/img/app-replay-player.jpg"
        alt="A Nile replay playing on demand, with the title and a scrub bar"
        radius="lg"
        ratio="16 / 9"
        class="vod-visual"
      />
      <div class="vod-copy">
        <p class="nile-eyebrow">Replays / VOD</p>
        <h2>Opening night, then the whole run.</h2>
        <p>
          Every premiere on Nile generates a replay automatically. Ticket buyers
          keep their access. Everyone who heard about it the next morning can
          buy the replay at whatever price you set.
        </p>
        <p>One film. Revenue on premiere night, and every week after.</p>
        <div class="chips">
          <span class="chip">ticket sales</span>
          <span class="chip">replay purchases</span>
          <span class="chip">Stripe payouts</span>
        </div>
      </div>
    </div>
  </section>

  <!-- THE ROOM AFTER SECTION -->
  <section class="nile-section">
    <div class="nile-container split">
      <div class="split-head">
        <p class="nile-eyebrow">The room after</p>
        <h2>The people who showed up are yours to keep.</h2>
      </div>
      <div class="split-body">
        <p>
          A festival screening ends and your audience walks out into someone
          else's lobby. On Nile, they follow you.
        </p>
        <p>
          Your next short, your next feature, your next work-in-progress
          screening: they hear about it first. And you're in a room with other
          filmmakers doing the same thing, which is how crews get built and how
          the next project gets cast.
        </p>
      </div>
    </div>
  </section>

  <!-- SETUP SECTION -->
  <section class="band nile-section">
    <div class="nile-container setup-simple">
      <div class="setup-simple-copy">
        <p class="nile-eyebrow">The setup</p>
        <h2>A laptop, your film, and a couple of phones.</h2>
        <p>
          No venue. No projectionist. Play the film from the same laptop you cut
          it on. Add a phone for your intro and another for the Q&amp;A, and put
          your cast on their own phones from wherever they are.
        </p>
        <p>
          Your film, your date, your price. Nile handles the ticketing, the
          stream, and the payouts.
        </p>
      </div>
      <ImageSlot
        label="on set"
        src="/img/filmmakers-setup.jpg"
        alt="Director watching a monitor while cast members stand on a lit set"
        radius="lg"
        ratio="3 / 2"
        class="setup-visual"
      />
    </div>
  </section>

  {/* PROOF: hidden until we have a real filmmaker testimonial and real
      ticket-sales figures to run here. Restore by deleting this comment wrapper.
  <section class="nile-section">
    <div class="nile-container">
      <div class="centered-head">
        <p class="nile-eyebrow">Proof</p>
        <h2>Filmmakers are already selling out their own premieres.</h2>
      </div>
      <div class="proof-grid">
        <div class="testimonial nile-card">
          <div class="testimonial-author">
            <span class="avatar"></span>
            <div class="author-lines">
              <span class="line line--wide"></span>
              <span class="line"></span>
            </div>
          </div>
          <p class="quote">
            "Filmmaker testimonial (placeholder). Real quotes and ticket-sales
            figures drop in here post-launch."
          </p>
        </div>
        <div class="earnings">
          <p class="earnings-label">Recent premieres now running</p>
          <div class="earnings-row">
            {
              proofPremieres.map((s) => (
                <div class="earnings-card nile-card">
                  <ImageSlot
                    label={s.label}
                    src={s.src}
                    alt={s.alt}
                    radius="sm"
                    ratio="16 / 9"
                  />
                  <span class="earnings-meta">{s.meta}</span>
                  <span class="earnings-figure">$ ...</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
  */}

  <!-- CLOSING CTA -->
  <section class="closing nile-section">
    <div class="nile-container closing-inner">
      <h2>Your film deserves an opening night.</h2>
      <p class="closing-sub">
        Set a date, set a price, and let the people who want to see it show up.
      </p>
      <button
        type="button"
        data-waitlist
        data-segment="filmmaker"
        class="nile-btn nile-btn--primary closing-btn"
      >
        Join the waitlist →
      </button>
      <a href="/host" class="secondary-link">See how hosting works →</a>
    </div>
  </section>
</BaseLayout>

<style>
  h2 {
    margin-bottom: var(--nile-s-2);
  }
  .seo-h2 {
    color: var(--nile-txt-tertiary);
    font-size: 0.95rem;
    margin-bottom: var(--nile-s-4);
  }
  /* Section backgrounds are handled by automatic zebra striping in brand.css. */
  .centered-head {
    text-align: center;
    margin-bottom: var(--nile-s-12);
  }
  .centered-head h2 {
    margin-bottom: 0;
  }

  /* Hero */
  .hero {
    padding-block: var(--nile-s-16) var(--nile-s-12);
  }
  .hero-h1 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--nile-s-12);
    align-items: center;
  }
  .hero-cta {
    display: flex;
    gap: var(--nile-s-3);
    align-items: center;
    margin-top: var(--nile-s-8);
  }

  /* The wait */
  .wait-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: var(--nile-s-12);
    align-items: center;
  }
  .wait-copy p {
    color: var(--nile-txt-secondary);
  }
  .wait-copy .seo-h2 {
    color: var(--nile-txt-tertiary);
  }

  /* The room after */
  .split {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--nile-s-12);
    align-items: start;
  }
  .split-head h2 {
    margin-bottom: 0;
  }
  .split-body p {
    color: var(--nile-txt-secondary);
  }

  /* Premiere night */
  .setup-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--nile-s-12);
    align-items: center;
  }
  .setup-copy p {
    color: var(--nile-txt-secondary);
  }
  .pull-card {
    margin-top: var(--nile-s-6);
    border-left: 3px solid var(--nile-volt);
    padding-left: var(--nile-s-4);
    background: transparent;
    box-shadow: none;
  }
  .pull-card p {
    color: var(--nile-txt-primary) !important;
    font-style: italic;
    margin: 0;
  }
  .angle-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--nile-s-3);
  }

  /* VOD */
  .vod-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--nile-s-12);
    align-items: center;
  }
  .vod-copy p {
    color: var(--nile-txt-secondary);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--nile-s-2);
    margin-top: var(--nile-s-4);
  }
  .chip {
    border: 1px solid var(--nile-border);
    border-radius: var(--nile-r-pill);
    padding: var(--nile-s-1) var(--nile-s-3);
    font-size: 0.85rem;
    color: var(--nile-txt-secondary);
  }

  /* Setup simple */
  .setup-simple {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--nile-s-12);
    align-items: center;
  }
  .setup-simple-copy p {
    color: var(--nile-txt-secondary);
  }

  /* Proof */
  .proof-grid {
    display: grid;
    grid-template-columns: 1.1fr 1.4fr;
    gap: var(--nile-s-6);
    align-items: stretch;
  }
  .testimonial {
    display: flex;
    flex-direction: column;
  }
  .testimonial-author {
    display: flex;
    align-items: center;
    gap: var(--nile-s-3);
  }
  .avatar {
    width: 40px;
    height: 40px;
    border-radius: var(--nile-r-pill);
    background: var(--nile-bg-raised);
    border: 1px solid var(--nile-border);
    flex: 0 0 auto;
  }
  .author-lines {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .line {
    display: block;
    height: 8px;
    width: 70px;
    border-radius: var(--nile-r-xs);
    background: var(--nile-bg-raised);
  }
  .line--wide {
    width: 110px;
  }
  .quote {
    margin: var(--nile-s-4) 0 0;
    color: var(--nile-txt-secondary);
    font-style: italic;
  }
  .earnings {
    display: flex;
    flex-direction: column;
  }
  .earnings-label {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--nile-txt-tertiary);
    margin-bottom: var(--nile-s-3);
  }
  .earnings-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--nile-s-3);
    align-items: start;
  }
  .earnings-card {
    display: flex;
    flex-direction: column;
    padding: var(--nile-s-3);
  }
  .earnings-meta {
    display: block;
    color: var(--nile-txt-secondary);
    font-size: 0.8rem;
    margin-top: var(--nile-s-2);
  }
  .earnings-figure {
    display: block;
    font-family: var(--nile-font-display);
    font-weight: 800;
    font-size: 1.1rem;
    margin-top: var(--nile-s-1);
  }

  /* Closing */
  .closing-inner {
    text-align: center;
    max-width: 600px;
  }
  .closing-sub {
    color: var(--nile-txt-secondary);
    margin-bottom: var(--nile-s-6);
  }
  .closing-btn {
    margin-bottom: var(--nile-s-4);
  }
  .secondary-link {
    display: block;
    color: var(--nile-volt);
    font-weight: 600;
    font-size: 0.9rem;
  }

  @media (max-width: 880px) {
    .hero-grid,
    .wait-grid,
    .split,
    .setup-grid,
    .setup-simple,
    .vod-grid,
    .proof-grid {
      grid-template-columns: 1fr;
      gap: var(--nile-s-8);
    }
    .wait-visual,
    .vod-copy {
      order: -1;
    }
    .hero-cta {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-cta .nile-btn {
      justify-content: center;
    }
  }

  @media (max-width: 520px) {
    .earnings-row {
      grid-template-columns: 1fr;
    }
  }
</style>
