---
import BaseLayout from "../layouts/BaseLayout.astro";
import ImageSlot from "../components/ImageSlot.astro";

// SEO pulled from website_copy_homepage.md metadata block.
const title = "Livestream & Sell Tickets to Your Live Events | Nile";
const description =
  "Nile is the live streaming platform built for ticketed events. Stream multiple camera angles from your phone, sell virtual tickets, and earn from live shows and on-demand replays.";

const steps = [
  {
    n: 1,
    img: "phone-rig setup",
    src: "/img/step-1-phone-rig.jpg",
    alt: "Two smartphones mounted on stands recording a live performance",
    title: "Set up your show",
    body: "Create an event, set your ticket price, and invite your crew. Your phones are your cameras.",
  },
  {
    n: 2,
    img: "live multi-angle",
    src: "/img/step-2-multi-angle.jpg",
    alt: "Camera operators filming a live show from several positions at once",
    title: "Go live",
    body: "Broadcast multiple camera angles simultaneously. Your audience picks their own view and watches from wherever they are, in the app or on the web.",
  },
  {
    n: 3,
    img: "earnings dashboard",
    src: "/img/app-earnings.jpg",
    alt: "A host's Nile earnings screen showing ticket, tip and sponsorship totals",
    title: "Keep earning",
    body: "Paid shows record a replay. Live ticket buyers watch it free, everyone else buys access after. One show, multiple revenue windows.",
  },
];

const audiences = [
  {
    name: "Musicians",
    img: "artist on stage",
    src: "/img/audience-musicians.jpg",
    alt: "Guitarist singing into a microphone under stage lights",
    body: "It's your merch table, for the show itself. From intimate sets to sold-out venues, sell virtual tickets to fans who couldn't make it. Fretboard cam, drum overhead, wide stage. All from your existing setup.",
    href: "/musicians",
    link: "For Musicians →",
  },
  {
    name: "Churches & Worship",
    img: "worship service",
    src: "/img/audience-worship.jpg",
    alt: "Congregation worshipping together during a church service",
    body: "Digital giving for digital attendance. Reach members who moved away, can't travel, or worship from abroad. No production crew needed. No app required to watch.",
    href: "/worship",
    link: "For Churches & Worship →",
  },
  {
    name: "Creators & Streamers",
    img: "creator streaming",
    src: "/img/audience-creators.jpg",
    alt: "Creator recording herself playing guitar to camera",
    body: "The premium tier you couldn't offer on free platforms. Free platforms give you reach. Nile gives you revenue. Turn your audience into ticket buyers for your best content.",
    href: "/creators",
    link: "For Creators →",
  },
  {
    name: "Any Live Event",
    img: "comedy · sport · fitness",
    src: "/img/audience-any-event.jpg",
    alt: "Performer holding a microphone on stage at a comedy night",
    body: "Sports, conferences, comedy, fitness, gaming. If people pay to be there in person, they'll pay to be there online.",
    href: "/host",
    link: "For Hosts →",
  },
];

const features = [
  {
    title: "Multiple angles",
    body: "See what the house cam misses.",
    src: "/img/feature-angles.jpg",
    alt: "The Nile player with a row of camera angles to switch between beneath it",
  },
  {
    title: "Live chat",
    body: "Watch with other fans in real time.",
    src: "/img/feature-chat.jpg",
    alt: "Live chat running alongside a Nile stream, with the host replying to viewers",
  },
  {
    title: "On-demand replay",
    body: "The show lives on after the stream ends.",
    src: "/img/feature-replay.jpg",
    alt: "The Nile replay player with a scrub bar part-way through a recorded show",
  },
  {
    title: "You control the algorithm",
    body: "Pick your topics when you sign up. That's what you'll see. Update them anytime in Settings.",
    src: "/img/feature-interests.jpg",
    alt: "Nile's topic picker, where tapping a topic grows it to weight what you see",
  },
];

// Example live-now cards (illustrative, not real-time) — swap for real event
// data at launch.
const liveNow = [
  {
    viewers: "1.2K",
    name: "Basement Tapes Vol. 6",
    price: "$12",
    src: "/img/live-1-band.jpg",
    alt: "Band performing on a small indoor stage",
  },
  {
    viewers: "840",
    name: "Open Mic Comedy Night",
    price: "$8",
    src: "/img/live-2-comedy.jpg",
    alt: "Stand-up comedian on stage holding a microphone",
  },
  {
    viewers: "410",
    name: "Sunrise HIIT Live",
    price: "$20",
    src: "/img/live-3-fitness.jpg",
    alt: "Instructor leading a group fitness class in a studio",
  },
  {
    viewers: "2.1K",
    name: "Rec League Finals",
    price: "$15",
    src: "/img/live-4-sports.jpg",
    alt: "Packed arena during a live basketball game",
  },
];
---

<BaseLayout title={title} description={description} canonical="/">
  <!-- ② HERO -->
  <section class="hero nile-section">
    <div class="nile-container hero-grid">
      <div class="hero-copy">
        <p class="nile-eyebrow">Live streaming for ticketed events</p>
        <h1>Your show, without the ceiling.</h1>
        <p class="nile-lead">
          Nile is the live streaming platform built for ticketed events.
          Multi-angle broadcasts, on-demand replays, and real revenue from the
          phone already in your pocket.
        </p>
        <div class="hero-cta">
          <button
            type="button"
            data-waitlist
            data-segment="host"
            class="nile-btn nile-btn--primary"
          >
            Start Streaming →
          </button>
          <a href="/watch" class="nile-btn nile-btn--secondary">Watch Events</a>
        </div>
      </div>

      <div class="hero-collage">
        <div class="collage-main">
          <ImageSlot
            label="main stage · wide"
            src="/img/home-hero-main-stage.jpg"
            alt="Band performing on a lit stage at a night concert"
            radius="lg"
          />
          <span class="nile-badge-live collage-badge">● Live</span>
        </div>
        <ImageSlot
          label="fretboard cam"
          src="/img/home-hero-fretboard.jpg"
          alt="Close-up of hands playing an acoustic guitar during a live set"
          radius="lg"
        />
        <ImageSlot
          label="crowd"
          src="/img/home-hero-crowd.jpg"
          alt="Concert audience with hands raised under stage lights"
          radius="lg"
        />
      </div>
    </div>
  </section>

  <!-- ③ HOW IT WORKS -->
  <section class="band nile-section">
    <div class="nile-container">
      <p class="nile-eyebrow">How it works</p>
      <h2>Live in three steps.</h2>
      <p class="section-sub">
        How to live stream and sell tickets to your event
      </p>
      <div class="steps">
        {
          steps.map((s) => (
            <div class="step nile-card">
              <div class="step-img">
                <ImageSlot
                  label={s.img}
                  src={s.src}
                  alt={s.alt}
                  radius="md"
                  ratio="16 / 9"
                />
                <span class="step-num">{s.n}</span>
              </div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ④ WHO IT'S FOR -->
  <section class="nile-section">
    <div class="nile-container">
      <p class="nile-eyebrow">Who it's for</p>
      <h2>Built for live.</h2>
      <div class="audience-grid">
        {
          audiences.map((a) => (
            <a href={a.href} class="audience nile-card">
              <div class="audience-img">
                <ImageSlot label={a.img} src={a.src} alt={a.alt} radius="md" />
              </div>
              <div class="audience-body">
                <h3>{a.name}</h3>
                <p>{a.body}</p>
                <span class="audience-link">{a.link}</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ⑤ VIEWER EXPERIENCE -->
  <section class="band nile-section">
    <div class="nile-container viewer-grid">
      <div class="viewer-copy">
        <p class="nile-eyebrow">Viewer experience</p>
        <h2>Watch like you're there.</h2>
        <p class="section-sub">Multi-angle live streaming you control</p>
        <p>
          Choose your angle. Switch mid-show. Chat live. Miss the stream? Paid
          shows come with an on-demand replay you can buy after. No app
          download required. Watch from any browser, or go deeper with the
          Nile app.
        </p>
      </div>
      <div class="feature-grid">
        {
          features.map((f) => (
            <div class="feature nile-card">
              <ImageSlot
                label={f.title}
                src={f.src}
                alt={f.alt}
                radius="md"
                ratio="16 / 9"
                class="feature-shot"
              />
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ⑥ LIVE NOW -->
  <section class="nile-section live-now">
    <div class="nile-container">
      <p class="nile-eyebrow">Live now</p>
      <h2>See who's live right now.</h2>
      <p class="section-sub">
        Every show has its own crowd and its own ticket price. Pick one and
        you're in.
      </p>
    </div>
    <div class="live-rail">
      {
        liveNow.map((e) => (
          <div class="live-card nile-card">
            <div class="live-thumb">
              <ImageSlot
                label="live show"
                src={e.src}
                alt={e.alt}
                radius="md"
                ratio="16 / 9"
              />
              <span class="nile-badge-live live-badge">● Live</span>
              <span class="live-count">◦ {e.viewers}</span>
            </div>
            <div class="live-meta">
              <span class="live-name">{e.name}</span>
              <span class="live-price">{e.price} ticket</span>
            </div>
          </div>
        ))
      }
      <div class="live-card live-card--peek nile-card" aria-hidden="true">
        <ImageSlot
          label=""
          src="/img/live-5-peek.jpg"
          alt=""
          radius="md"
          ratio="16 / 9"
        />
      </div>
    </div>
  </section>

  <!-- ⑦ WAITLIST CTA -->
  <section class="waitlist-cta nile-section">
    <div class="nile-container waitlist-inner">
      <p class="nile-eyebrow">Get early access</p>
      <h2>Start watching tonight.</h2>
      <p class="section-sub center">
        Download the Nile app or watch right from your browser. We'll email you
        the moment Nile goes live.
      </p>
      <button
        type="button"
        data-waitlist
        data-segment="viewer"
        class="nile-btn nile-btn--primary waitlist-btn"
      >
        Join the waitlist →
      </button>
      <div class="store-row">
        <span class="store-pill" aria-disabled="true">
          Download on the App Store · soon
        </span>
        <span class="store-pill" aria-disabled="true">
          Get it on Google Play · soon
        </span>
        <a href="/watch" class="watch-web">Watch on Web →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h2 {
    margin-bottom: var(--nile-s-2);
  }
  .section-sub {
    color: var(--nile-txt-secondary);
    margin-bottom: var(--nile-s-8);
  }
  .section-sub.center {
    text-align: center;
  }
  /* Section backgrounds are handled by automatic zebra striping in brand.css. */

  /* ② Hero */
  .hero {
    padding-block: var(--nile-s-16) var(--nile-s-12);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--nile-s-12);
    align-items: center;
  }
  .hero-cta {
    display: flex;
    gap: var(--nile-s-3);
    margin-top: var(--nile-s-8);
  }
  .hero-collage {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: var(--nile-s-3);
    aspect-ratio: 4 / 3;
  }
  .collage-main {
    grid-row: span 2;
    position: relative;
  }
  .collage-badge {
    position: absolute;
    top: var(--nile-s-3);
    left: var(--nile-s-3);
  }

  /* ③ How it works */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--nile-s-4);
  }
  .step {
    padding: 0;
    overflow: hidden;
  }
  .step-img {
    position: relative;
  }
  .step-num {
    position: absolute;
    top: var(--nile-s-3);
    left: var(--nile-s-3);
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    background: var(--nile-volt);
    color: var(--nile-on-volt);
    font-weight: 700;
    border-radius: var(--nile-r-pill);
  }
  .step h3,
  .step p {
    padding-inline: var(--nile-s-6);
  }
  .step h3 {
    margin-top: var(--nile-s-4);
  }
  .step p {
    color: var(--nile-txt-secondary);
    padding-bottom: var(--nile-s-6);
  }

  /* ④ Who it's for */
  .audience-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--nile-s-4);
  }
  .audience {
    padding: 0;
    overflow: hidden;
    display: flex;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }
  .audience:hover {
    border-color: var(--nile-border-strong);
    text-decoration: none;
  }
  /* No aspect-ratio here on purpose: the slot stretches to the card's height so
     the photo and the copy column always end flush. */
  .audience-img {
    flex: 0 0 200px;
    align-self: stretch;
  }
  /* The card clips to its own radius, so square the slot off — otherwise its
     inner corners curve away from the copy column. Beats the inline radius. */
  .audience-img :global(.img-slot) {
    border-radius: 0 !important;
  }
  .audience-body {
    padding: var(--nile-s-6);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--nile-s-2);
  }
  .audience-body h3 {
    margin-bottom: 0;
  }
  .audience-body p {
    color: var(--nile-txt-secondary);
    font-size: 0.95rem;
  }
  /* Pin the link to the bottom so it lines up across cards of unequal copy. */
  .audience-link {
    color: var(--nile-volt);
    font-weight: 600;
    font-size: 0.9rem;
    margin-top: auto;
    padding-top: var(--nile-s-2);
  }

  /* ⑤ Viewer experience */
  .viewer-grid {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: var(--nile-s-12);
    align-items: start;
  }
  .viewer-copy p {
    color: var(--nile-txt-secondary);
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--nile-s-4);
  }
  /* Matches the "How it works" step cards: the shot bleeds to the card edge
     instead of sitting inset in the default nile-card padding. */
  .feature {
    padding: 0;
    overflow: hidden;
  }
  .feature h3,
  .feature p {
    padding-inline: var(--nile-s-6);
  }
  .feature h3 {
    margin-top: var(--nile-s-4);
    font-size: 1.1rem;
    margin-bottom: var(--nile-s-1);
  }
  .feature p {
    color: var(--nile-txt-secondary);
    font-size: 0.9rem;
    margin: 0;
    padding-bottom: var(--nile-s-6);
  }

  /* ⑥ Live now */
  .live-rail {
    display: flex;
    gap: var(--nile-s-4);
    overflow-x: auto;
    padding: var(--nile-s-2) var(--nile-s-6) var(--nile-s-4);
    max-width: var(--nile-max-width);
    margin-inline: auto;
    scroll-snap-type: x mandatory;
    /* Without this the first snap point is the card's own edge, so the rail
       loads scrolled past its left padding and the card sits flush to the
       screen edge. */
    scroll-padding-inline: var(--nile-s-6);
  }
  .live-card {
    flex: 0 0 230px;
    padding: 0;
    overflow: hidden;
    scroll-snap-align: start;
  }
  .live-card--peek {
    opacity: 0.4;
  }
  .live-thumb {
    position: relative;
  }
  .live-badge {
    position: absolute;
    top: var(--nile-s-2);
    left: var(--nile-s-2);
  }
  .live-count {
    position: absolute;
    top: var(--nile-s-2);
    right: var(--nile-s-2);
    background: color-mix(in srgb, var(--nile-bg-page) 70%, transparent);
    color: var(--nile-txt-secondary);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: var(--nile-r-pill);
  }
  .live-meta {
    padding: var(--nile-s-3) var(--nile-s-4) var(--nile-s-4);
  }
  .live-name {
    display: block;
    font-weight: 700;
  }
  .live-price {
    display: block;
    margin-top: var(--nile-s-2);
    color: var(--nile-volt);
    font-weight: 600;
    font-size: 0.9rem;
  }

  /* ⑦ Waitlist CTA */
  .waitlist-inner {
    text-align: center;
    max-width: 640px;
  }
  .waitlist-btn {
    margin-top: var(--nile-s-2);
  }
  .store-row {
    display: flex;
    gap: var(--nile-s-3);
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--nile-s-6);
  }
  .store-pill {
    padding: var(--nile-s-3) var(--nile-s-4);
    border: 1px solid var(--nile-border);
    border-radius: var(--nile-r-pill);
    color: var(--nile-txt-tertiary);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .watch-web {
    color: var(--nile-volt);
    font-weight: 600;
    font-size: 0.9rem;
  }

  /* ---- Responsive: collapse to single column (mobile-first wireframe) ---- */
  @media (max-width: 880px) {
    .hero-grid,
    .viewer-grid {
      grid-template-columns: 1fr;
      gap: var(--nile-s-8);
    }
    .audience-grid,
    .feature-grid {
      grid-template-columns: 1fr 1fr;
    }
    .audience {
      flex-direction: column;
    }
    /* Stacked: the slot no longer has a card height to stretch into, so give it
       an explicit band. */
    .audience-img {
      flex: 0 0 200px;
    }
  }
  /* Full-width stacked CTAs are a phone pattern; tablets keep them inline. */
  @media (max-width: 600px) {
    .steps,
    .audience-grid,
    .feature-grid {
      grid-template-columns: 1fr;
    }
    .hero-cta {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-cta .nile-btn {
      justify-content: center;
    }
  }
</style>
