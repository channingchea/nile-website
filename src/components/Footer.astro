---
import { FOOTER_NAV, LEGAL_NAV, SITE } from "../site.config";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="nile-container footer-inner">
    <div class="footer-brand">
      <span class="brand">
        <img src="/logo-mark.png" alt="" class="brand-mark" width="42" height="20" />
        Nile
      </span>
      <p class="tagline">Your show, without the ceiling.</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      {FOOTER_NAV.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>

  <div class="nile-container footer-bottom">
    <p class="copyright">© {year} Nile. Available in the US.</p>
    <nav class="footer-legal" aria-label="Legal">
      {LEGAL_NAV.map((item) => <a href={item.href}>{item.label}</a>)}
      <button type="button" id="privacy-choices" class="privacy-choices"></button>
    </nav>
  </div>
</footer>

<script is:inline>
  // "Your Privacy Choices" — CCPA opt-out of ad tracking (Google Ads / Meta
  // Pixel). Toggles a flag BaseLayout's tracking loader checks before it
  // loads anything, then reloads so the choice takes effect immediately.
  (function () {
    var btn = document.getElementById("privacy-choices");
    if (!btn) return;
    function optedOut() {
      try {
        return localStorage.getItem("nile-ad-optout") === "1";
      } catch (e) {
        return false;
      }
    }
    function render() {
      btn.textContent = optedOut()
        ? "Ad Tracking Off (tap to re-enable)"
        : "Do Not Sell or Share My Info";
    }
    render();
    btn.addEventListener("click", function () {
      try {
        localStorage.setItem("nile-ad-optout", optedOut() ? "0" : "1");
      } catch (e) {}
      location.reload();
    });
  })();
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--nile-border);
    background: var(--nile-bg-surface);
    padding-block: var(--nile-s-12) var(--nile-s-6);
    margin-top: var(--nile-s-16);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--nile-s-8);
    justify-content: space-between;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--nile-s-2);
    font-family: var(--nile-font-display);
    font-weight: 800;
    font-size: 1.5rem;
    color: var(--nile-volt);
  }
  .brand-mark {
    height: 20px;
    width: auto;
  }
  .tagline {
    color: var(--nile-txt-secondary);
    margin-top: var(--nile-s-2);
  }
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--nile-s-4);
    align-content: flex-start;
    max-width: 480px;
  }
  .footer-nav a {
    color: var(--nile-txt-secondary);
    font-size: 0.95rem;
    text-decoration: none;
  }
  .footer-nav a:hover {
    color: var(--nile-txt-primary);
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--nile-s-4);
    margin-top: var(--nile-s-8);
    padding-top: var(--nile-s-6);
    border-top: 1px solid var(--nile-border);
  }
  .copyright {
    color: var(--nile-txt-tertiary);
    font-size: 0.85rem;
    margin: 0;
  }
  .footer-legal {
    display: flex;
    gap: var(--nile-s-4);
  }
  .footer-legal a {
    color: var(--nile-txt-tertiary);
    font-size: 0.85rem;
    text-decoration: none;
  }
  .footer-legal a:hover {
    color: var(--nile-txt-secondary);
  }
  .privacy-choices {
    background: none;
    border: none;
    padding: 0;
    color: var(--nile-txt-tertiary);
    font-size: 0.85rem;
    font-family: var(--nile-font-body);
    cursor: pointer;
  }
  .privacy-choices:hover {
    color: var(--nile-txt-secondary);
  }
</style>
