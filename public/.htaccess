# Cache policy for the static Astro build.
#
# Filenames under /_astro/ are content-hashed, and every deploy deletes the
# previous hashes. So a browser that serves an HTML page out of its own cache
# after a deploy asks for a stylesheet that no longer exists, gets a 404, and
# renders the page with no styles at all. HTML must always be revalidated;
# hashed assets never need to be.
#
# Without this file the server sends no Cache-Control at all, and browsers fall
# back to heuristic freshness (~10% of the time since Last-Modified), which can
# hold an HTML page for days with no revalidation.

<IfModule mod_headers.c>
  # Default: revalidate. A 304 is cheap; a stranded page is not.
  Header set Cache-Control "no-cache, must-revalidate"

  # Content-hashed build output — safe to cache forever.
  <FilesMatch "\.[0-9A-Za-z_-]{8}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Unhashed static files: cache for a day.
  <FilesMatch "\.(png|jpe?g|gif|svg|webp|avif|ico|woff2?|mp4)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType text/css .css
  AddType text/javascript .js
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
</IfModule>
