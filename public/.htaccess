# ── Hosts ─────────────────────────────────────────────────────────────────────
# joinnile.com and ads.joinnile.com share this one build (same docroot), so
# host-specific routing lives here.
#
# ads.joinnile.com is the advertiser site only: its home page is the Advertise
# page (served at "/", no redirect), the portal stays at /advertise/portal/,
# and every other page 301s to the same path on joinnile.com. Built assets and
# static files are served on both hosts, or the ads pages would lose them.
#
# The portal itself lives on ads only. Sign-ins are stored per host, so one
# copy on each would mean two separate sign-ins for the same advertiser.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^ads\.joinnile\.com$ [NC]
  RewriteRule ^$ advertise/index.html [L]

  RewriteCond %{HTTP_HOST} ^ads\.joinnile\.com$ [NC]
  RewriteCond %{REQUEST_URI} !^/(advertise|_astro|img|og)(/|$)
  RewriteCond %{REQUEST_URI} !\.(png|jpe?g|gif|svg|ico|webp|avif|mp4|woff2?|xml|txt|json|webmanifest)$ [NC]
  RewriteRule ^ https://joinnile.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?joinnile\.com$ [NC]
  RewriteRule ^advertise/portal(/.*)?$ https://ads.joinnile.com/advertise/portal/ [R=301,L]
</IfModule>

# Cache policy for the static Astro build.
#
# Filenames under /_astro/ are content-hashed, and every deploy deletes the
# previous hashes. So a browser that serves an HTML page out of its own cache
# after a deploy asks for a stylesheet that no longer exists, gets a 404, and
# renders the page with no styles at all. HTML must always be revalidated;
# hashed assets never need to be.
#
# Without this file the server sends no Cache-Control at all, and browsers fall
# back to heuristic freshness (~10% of the time since Last-Modified), which can
# hold an HTML page for days with no revalidation.

<IfModule mod_headers.c>
  # Default: revalidate. A 304 is cheap; a stranded page is not.
  Header set Cache-Control "no-cache, must-revalidate"

  # Content-hashed build output — safe to cache forever.
  <FilesMatch "\.[0-9A-Za-z_-]{8}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Unhashed static files: cache for a day.
  <FilesMatch "\.(png|jpe?g|gif|svg|webp|avif|ico|woff2?|mp4)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType text/css .css
  AddType text/javascript .js
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
</IfModule>
